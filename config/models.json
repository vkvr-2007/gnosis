{
  "_about": "Which models Gnosis thinks with. Read by bridge/models.mjs and bridge/sdk.mjs. Keys come from environment variables, never this file.",
  "default": "planner",
  "providers": {
    "nvidia": {
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "keyEnv": "NVIDIA_API_KEY"
    },
    "nebius": {
      "baseUrl": "https://api.studio.nebius.com/v1",
      "keyEnv": "NEBIUS_API_KEY"
    },
    "local": {
      "baseUrl": "http://127.0.0.1:8081/v1",
      "onDevice": true
    }
  },
  "roles": {
    "planner": {
      "provider": "nvidia",
      "model": "nvidia/nemotron-3-super-120b-a12b",
      "extraBody": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    },
    "research": {
      "provider": "nvidia",
      "model": "nvidia/nemotron-3-super-120b-a12b",
      "extraBody": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    },
    "vision": {
      "provider": "nvidia",
      "model": "nvidia/nemotron-3.5-super-vl-120b-a12b",
      "_about": "Reads pictures for the brain (bridge/vision.mjs): the screen, the webcam, screenshots.",
      "extraBody": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    },
    "local": {
      "provider": "local",
      "model": "nemotron-nano-local",
      "temperature": 0,
      "_tools": "The small on-device model only gets these: every tool schema costs it time and accuracy.",
      "tools": [
        "Read",
        "Glob",
        "Grep",
        "PowerShell",
        "mcp__ayra_apps__apps_list",
        "mcp__ayra_apps__apps_open",
        "mcp__ayra_apps__apps_read",
        "mcp__ayra_apps__apps_focus",
        "mcp__ayra_apps__apps_close",
        "mcp__ayra_browser__browser_open",
        "mcp__ayra_browser__browser_read"
      ],
      "systemPrefix": "detailed thinking off"
    }
  },
  "private": {
    "_about": "Private work thinks on the laptop (the local role) and is blanked from what the cloud model sees later. A request is private when it is sensitive (bridge/privacy.mjs: passwords, contacts, email, bank and card details, IDs, health, the word private, or personal data in it), or once one of these tools has brought back personal data.",
    "tools": [
      "Read",
      "Grep",
      "mcp__ayra_apps__apps_read",
      "mcp__ayra_browser__browser_read",
      "mcp__ayra_browser__browser_open"
    ]
  }
}
