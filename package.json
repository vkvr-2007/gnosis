{
  "name": "gnosis",
  "private": true,
  "version": "3.0.0",
  "description": "AYRA — a personal assistant with an avatar face and an ElevenLabs voice, driven by Claude Code through a small Node bridge. Forked from adewaskar/jarvis.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:dev": "node scripts/start.mjs --dev",
    "shortcuts": "node scripts/shortcuts.mjs",
    "icon": "node scripts/icon.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bridge": "node bridge/server.mjs",
    "bridge:test": "node scripts/bridge-copy.mjs",
    "setup": "node scripts/setup.mjs",
    "smoke": "node scripts/smoke.mjs",
    "bench": "node scripts/bench.mjs",
    "demo": "node scripts/demo.mjs",
    "research": "node scripts/research.mjs",
    "test": "node --import tsx --test",
    "mascot": "node scripts/mascot.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "puppeteer-core": "^25.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
